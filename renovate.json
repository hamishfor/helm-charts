{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(feat)"
  ],
  "ignoreDeps": [
    "postgresql",
    "redis"
  ],
  "packageRules": [
    {
      "description": "Bump the chart version so the release workflow publishes the update",
      "matchManagers": ["helmv3", "helm-values"],
      "bumpVersion": "patch"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^charts/.+/Chart\\.yaml$"
      ],
      "matchStrings": [
        "image:\\s+\"(?<depName>[a-zA-Z0-9/._-]+):(?<currentValue>[a-zA-Z0-9._@:-]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^charts/.+/values\\.yaml$"
      ],
      "matchStrings": [
        "\\s+repository:\\s+\"?(?<depName>[a-zA-Z0-9/._-]+)\"?\\n\\s+tag:\\s+\"?(?<currentValue>[a-zA-Z0-9._@:-]+)\"?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^charts/.+/Chart\\.yaml$"
      ],
      "matchStrings": [
        "# image: \"(?<depName>[a-zA-Z0-9/._-]+)\"\\nappVersion:\\s+\"?(?<currentValue>v?[a-zA-Z0-9._-]+)\"?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "helmv3": {
    "enabled": true
  }
}
